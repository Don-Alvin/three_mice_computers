# Copy to .env and fill in real values. NEVER commit .env.
# See docs implementation plan §3 — this is the complete list.

# Postgres connection string (Neon or Supabase, free tier).
# Use the POOLER/pooled connection URL, not the direct one — Vercel functions
# open many short-lived connections.
DATABASE_URI=postgres://user:password@host:5432/database

# Payload signing secret. Minimum 32 characters.
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-me-with-a-32-char-random-string

# Public base URL of this deployment, no trailing slash.
# Local: http://localhost:3000   Preview/prod: the Vercel or custom domain.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Shop's WhatsApp business number, international format, digits only, no '+'.
NEXT_PUBLIC_WHATSAPP_NUMBER=2547XXXXXXXX

# Vercel Blob read/write token — only if media storage uses Vercel Blob.
# Leave unset when using Supabase Storage instead.
BLOB_READ_WRITE_TOKEN=
